# $Agent Environment Configuration (BYOK - Bring Your Own Key)

# Active LLM Provider: 'gemini' | 'openai' | 'anthropic'
AI_PROVIDER=gemini

# Google Gemini API Configuration (Default MVP)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Optional: OpenAI API Key (BYOK)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# Optional: Anthropic API Key (BYOK)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
ANTHROPIC_MODEL=claude-opus-5

# Deco Storefront API Base URL (Mock or Live)
DECO_API_BASE_URL=https://api.deco.cx
